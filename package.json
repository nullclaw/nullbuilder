{
  "name": "nullbuilder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "nullbuilder": "./bin/nullbuilder.js"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "npm run build:cli && vite build",
    "build:cli": "node scripts/build-cli.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "nb": "tsx src/cli/nullbuilder.ts"
  },
  "overrides": {
    "cookie": "0.7.2"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@lucide/svelte": "1.17.0",
    "@sveltejs/adapter-auto": "7.0.1",
    "@sveltejs/kit": "^2.64.0",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@types/node": "^25.9.2",
    "esbuild": "0.28.0",
    "svelte": "^5.56.3",
    "svelte-check": "4.6.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  }
}
